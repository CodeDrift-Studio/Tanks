# =========================
# Default behavior
# =========================
* text=auto

# =========================
# C# and script files (normalized text)
# =========================
*.cs        text eol=lf
*.js        text eol=lf
*.shader    text eol=lf
*.compute   text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf

# =========================
# Unity YAML-based files (MUST stay text, diffable)
# With Asset Serialization = Force Text these are all YAML.
# =========================
*.unity             text eol=lf
*.prefab            text eol=lf
*.mat               text eol=lf
*.anim              text eol=lf
*.controller        text eol=lf
*.overrideController text eol=lf
*.playable          text eol=lf
*.mask              text eol=lf
*.spriteatlas       text eol=lf
*.mixer             text eol=lf
*.lighting          text eol=lf
*.scenetemplate     text eol=lf
*.meta              text eol=lf
# .asset is YAML under Force Text. text=auto lets Git detect the few genuinely binary
# .asset files (see the explicit binary overrides below) and leave them untouched.
*.asset             text=auto eol=lf
# Binary-serialized .asset files that Unity writes as binary regardless of Force Text
*LightingData*.asset binary
NavMesh*.asset       binary

# =========================
# Binary assets
# NOTE: the owner-supplied rules routed these to Git LFS. LFS is installed, but about 140
# of these files are already stored as ordinary blobs in history, so enabling the filter would
# make them appear modified and amount to an LFS migration, which needs explicit approval
# (DECISION_REGISTER DR-P19 / DR-P21). They are marked binary for now; the LFS version of every
# line is kept in the DISABLED block at the bottom, ready to enable after that decision.
# =========================
*.png       binary
*.jpg       binary
*.jpeg      binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.bmp       binary
*.psd       binary
*.psb       binary
*.exr       binary
*.hdr       binary
*.cubemap   binary
*.fbx       binary
*.FBX       binary
*.obj       binary
*.blend     binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.aif       binary
*.mp4       binary
*.mov       binary
*.ttf       binary
*.otf       binary
*.dll       binary
*.so        binary
*.aar       binary
*.srcaar    binary
*.bin       binary
*.bytes     binary
*.bundle    binary
*.dylib     binary
*.pdb       binary
*.a         binary
*.pdf       binary
*.unitypackage binary

